{
  "name": "cloud-jet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve:offline": "node scripts/serve.mjs",
    "format": "prettier --write src tests scripts index.html package.json tsconfig.json",
    "format:check": "prettier --check src tests scripts index.html package.json tsconfig.json"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/three": "0.183.1",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
